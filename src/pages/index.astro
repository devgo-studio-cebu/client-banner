---
import { CLIENT_NAME, CONTACT_EMAIL, CONTACT_PHONE } from "astro:env/server";
import BaseLayout from "../layouts/BaseLayout.astro";
import DitheredVideoBackground from "../components/DitheredVideoBackground.astro";

const clientName = CLIENT_NAME || "";
const contactEmail = CONTACT_EMAIL || "official@devgo.studio";
const contactPhone = CONTACT_PHONE || "";

const seoProps = {
    title: clientName
        ? `${clientName} – Under Development | DEVGO Studio`
        : "Site Under Development | DEVGO Studio",
    description: clientName
        ? `${clientName} is currently under development. Contact DEVGO Studio for more information.`
        : "This site is currently under development. Contact DEVGO Studio for more information about this project.",
    keywords: [
        "devgo",
        "studio",
        "under development",
        "coming soon",
        clientName,
    ].filter(Boolean),
    type: "website" as const,
};
---

<BaseLayout seo={seoProps}>
    <!-- Full-viewport video + halftone background -->
    <DitheredVideoBackground
        src="/bg-fish.mp4"
        mode="dots"
        cellSize={10}
        playbackRate={.35}
        ditherStrength={0.2}
        shadowCrush={0.15}
        highlightCeil={.8}
        dotColor="#5fcba6"
        class="fixed inset-0 w-full h-full"
    />

    <!-- Subtle vignette to draw focus inward -->
    <div
        class="fixed inset-0 pointer-events-none z-20"
        style="background: radial-gradient(ellipse at center, transparent 35%, rgba(4,9,6,0.75) 100%);"
    >
    </div>

    <!-- Main content -->
    <main
        class="relative z-30 flex-1 flex items-center justify-center min-h-svh w-full px-5 py-10 md:px-10 md:py-16"
    >
        <div class="w-full max-w-4xl hero-wrapper">
            <!-- Unified editorial card -->
            <div class="border border-accent/15 bg-bg/80 backdrop-blur-[3px] overflow-hidden transition-all duration-500 hover:border-accent/25 hover:bg-bg">

                <!-- Top section: Client + Status -->
                <div class="p-6 md:p-10 lg:p-14 hero-section">
                    <!-- Client label -->
                    <div class="flex items-center gap-2.5 mb-5">
                        <span class="text-accent/45 text-[10px] uppercase tracking-[0.28em] font-sans font-semibold">Client</span>
                    </div>

                    <!-- Client name -->
                    <p class="font-head uppercase text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-text leading-[0.825] tracking-tight">
                        {clientName || "TBA"}
                    </p>

                    <!-- Status compact line below name -->
                    <div class="flex items-center gap-3 mt-5 md:mt-6">
                        <span class="text-accent/40 text-[10px] uppercase tracking-[0.25em] font-sans font-semibold">Status</span>
                        <span class="h-px w-5 bg-accent/20"></span>
                        <h1 class="font-head uppercase text-sm sm:text-base md:text-lg text-text/70 tracking-tight leading-none">
                            Under Development
                        </h1>
                    </div>
                </div>

                <!-- Divider -->
                <div class="mx-6 md:mx-10 lg:mx-14 h-px bg-accent/8 hero-line"></div>

                <!-- Middle section: About -->
                <div class="p-6 md:p-10 lg:p-14 grid grid-cols-1 md:grid-cols-5 gap-6 md:gap-10 hero-section">
                    <div class="md:col-span-1">
                        <div class="flex items-center gap-2.5 mb-0 md:mb-0">
                            <span class="text-accent/45 text-[10px] uppercase tracking-[0.28em] font-sans font-semibold">About</span>
                        </div>
                    </div>
                    <div class="md:col-span-4">
                        <p class="font-sans text-sm md:text-base lg:text-[17px] text-text/50 leading-[1.7] max-w-xl">
                            A new digital experience is currently being built here. Something clean, fast, and purposeful is on its way.
                        </p>
                    </div>
                </div>

                <!-- Divider -->
                <div class="mx-6 md:mx-10 lg:mx-14 h-px bg-accent/8 hero-line"></div>

                <!-- Bottom section: Contact + Studio -->
                <div class="p-6 md:p-10 lg:p-14 flex flex-col md:flex-row md:items-end md:justify-between gap-8 md:gap-12 hero-section">
                    <!-- Contact -->
                    <div class="flex-1">
                        <div class="flex items-center gap-2.5 mb-5">
                            <span class="text-accent/45 text-[10px] uppercase tracking-[0.28em] font-sans font-semibold">Contact</span>
                        </div>
                        <a
                            href={`mailto:${contactEmail}`}
                            class="font-sans text-sm md:text-base text-accent/70 hover:text-accent transition-colors duration-300 break-all block"
                        >
                            {contactEmail}
                        </a>
                        {contactPhone && (
                            <a
                                href={`tel:${contactPhone}`}
                                class="font-sans text-sm md:text-base text-accent/70 hover:text-accent transition-colors duration-300 mt-1 block"
                            >
                                {contactPhone}
                            </a>
                        )}
                        <p class="font-sans text-xs md:text-sm text-text/30 mt-3">
                            Questions? Reach out anytime.
                        </p>
                    </div>

                    <!-- Studio -->
                    <div class="md:text-right shrink-0">
                        <div class="flex items-center gap-2.5 mb-5 md:justify-end">
                            <span class="text-accent/45 text-[10px] uppercase tracking-[0.28em] font-sans font-semibold">Studio</span>
                        </div>
                        <p class="font-head uppercase text-2xl sm:text-3xl md:text-4xl text-text/90 leading-[0.88] tracking-tight">
                            DEVGO<br>STUDIO
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </main>
</BaseLayout>
