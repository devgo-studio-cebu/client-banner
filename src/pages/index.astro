---
import { CLIENT_NAME, CONTACT_EMAIL } from "astro:env/server";
import BaseLayout from "../layouts/BaseLayout.astro";
import DitheredVideoBackground from "../components/DitheredVideoBackground.astro";

const clientName = CLIENT_NAME || "";
const contactEmail = CONTACT_EMAIL || "official@devgo.studio";

const seoProps = {
    title: clientName
        ? `${clientName} – Under Development | DEVGO Studio`
        : "Site Under Development | DEVGO Studio",
    description: clientName
        ? `${clientName} is currently under development. Contact DEVGO Studio for more information.`
        : "This site is currently under development. Contact DEVGO Studio for more information about this project.",
    keywords: [
        "devgo",
        "studio",
        "under development",
        "coming soon",
        clientName,
    ].filter(Boolean),
    type: "website" as const,
};
---

<BaseLayout seo={seoProps}>
    <!-- Full-viewport video + halftone background -->
    <DitheredVideoBackground
        src="/banner-bg.webm"
        mode="dots"
        cellSize={5}
        ditherStrength={1.2}
        shadowCrush={0.55}
        playbackRate={0.5}
        dotColor="#5fcba6"
        class="fixed inset-0 w-full h-full"
    />

    <!-- Subtle vignette to draw focus inward -->
    <div
        class="fixed inset-0 pointer-events-none z-20"
        style="background: radial-gradient(ellipse at center, transparent 40%, rgba(4,9,6,0.7) 100%);"
    >
    </div>

    <!-- Main content -->
    <main
        class="relative z-100 flex-1 flex flex-col items-center justify-center text-center min-w-svw min-h-svh px-22"
    >
        <!-- Outlines -->
        <div class="absolute h-svh w-[90svw] border-x border-text/20"></div>
        <div class="absolute h-[90svh] w-svw border-y border-text/20"></div>

        <!-- Actual Content -->
        <section class="w-[85svw] h-[85svh]"></section>
    </main>
</BaseLayout>
