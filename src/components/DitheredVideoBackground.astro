---
/**
 * DitheredVideoBackground
 *
 * A self-contained Astro component that renders a muted background video with a
 * real-time WebGL ordered-dither / halftone shader overlay. The pattern is locked
 * to screen pixels so it stays crisp while the video moves underneath.
 *
 * Props:
 *   - src            Video source URL (required)
 *   - cellSize       Halftone cell size in pixels (default: 6)
 *   - ditherStrength Amount of Bayer dithering 0..2 (default: 1.0)
 *   - dotColor       Pattern color as hex string (default: #ffffff)
 *   - mode           "dots" | "lines" | "crosshatch" (default: "dots")
 *   - poster         Poster image shown before video loads
 *   - coverFit       Match shader UVs to CSS object-cover (default: true)
 *   - shadowCrush    Luminance below this value is fully crushed (0..1, default: 0.50)
 *   - playbackRate   Video playback speed (default: 0.5)
 *   - class          Extra CSS classes for the wrapper
 */
interface Props {
    src: string
    cellSize?: number
    ditherStrength?: number
    dotColor?: string
    mode?: "dots" | "lines" | "crosshatch"
    poster?: string
    coverFit?: boolean
    shadowCrush?: number
    playbackRate?: number
    class?: string
}

const {
    src,
    cellSize = 6,
    ditherStrength = 1.0,
    dotColor = "#ffffff",
    mode = "dots",
    poster,
    coverFit = true,
    shadowCrush = 0.50,
    playbackRate = 0.5,
    class: className = "",
} = Astro.props

/** Hex → normalized RGB */
function hexToRgb(hex: string) {
    const h = hex.replace("#", "")
    const full = h.length === 3 ? h.split("").map((c) => c + c).join("") : h
    const n = parseInt(full, 16)
    return {
        r: ((n >> 16) & 255) / 255,
        g: ((n >> 8) & 255) / 255,
        b: (n & 255) / 255,
    }
}

const { r, g, b } = hexToRgb(dotColor)
const modeVal = mode === "lines" ? 1 : mode === "crosshatch" ? 2 : 0
---

<div
    class={`dither-video-wrapper absolute inset-0 w-full h-full overflow-hidden ${className}`}
    aria-hidden="true"
    role="presentation"
    data-src={src}
    data-cell-size={cellSize}
    data-dither-strength={ditherStrength}
    data-fg-r={r.toFixed(4)}
    data-fg-g={g.toFixed(4)}
    data-fg-b={b.toFixed(4)}
    data-mode={modeVal}
    data-cover-fit={coverFit ? "1" : "0"}
    data-shadow-crush={shadowCrush}
    data-playback-rate={playbackRate}
>
    {/* Solid dark background — the video itself is sampled for data only */}
    <div class="absolute inset-0 bg-bg" />

    {/* Video element: opacity-0 so it drives the shader but is NOT visually rendered */}
    <video
        class="absolute inset-0 w-full h-full object-cover opacity-0"
        src={src}
        poster={poster}
        muted
        autoplay
        loop
        playsinline
        preload="metadata"
        crossorigin="anonymous"
    />
    <canvas class="absolute inset-0 w-full h-full block z-10" />

    {/* Reduced-motion fallback: solid accent glow */}
    <div
        class="absolute inset-0 z-[5] hidden reduced-motion-fallback"
        style="background: radial-gradient(ellipse at center, rgba(95,203,166,0.08) 0%, transparent 70%);"
    />
</div>

<style>
    .dither-video-wrapper {
        opacity: 0;
        animation: dither-fade-in 1.4s ease-out forwards;
    }

    @keyframes dither-fade-in {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .dither-video-wrapper video,
        .dither-video-wrapper canvas {
            display: none !important;
        }
        .dither-video-wrapper .reduced-motion-fallback {
            display: block !important;
        }
        .dither-video-wrapper {
            animation: none !important;
            opacity: 1 !important;
        }
    }
</style>

<script>
    // ─────────────────────────────────────────────────────────────────────────
    //  VERTEX SHADER  —  single full-screen quad
    // ─────────────────────────────────────────────────────────────────────────
    const VERTEX_SHADER = `
        attribute vec2 a_position;
        varying vec2 v_uv;
        void main() {
            gl_Position = vec4(a_position, 0.0, 1.0);
            v_uv = a_position * 0.5 + 0.5;
        }
    `

    // ─────────────────────────────────────────────────────────────────────────
    //  FRAGMENT SHADER  —  Bayer ordered dither + variable halftone dots/lines
    // ─────────────────────────────────────────────────────────────────────────
    const FRAGMENT_SHADER = `
        precision highp float;

        uniform sampler2D u_video;
        uniform vec2  u_resolution;
        uniform float u_cellSize;
        uniform float u_ditherStrength;
        uniform vec3  u_fgColor;
        uniform float u_mode;
        uniform float u_videoAspect;
        uniform float u_containerAspect;
        uniform float u_coverFit;
        uniform float u_shadowCrush;

        varying vec2 v_uv;

        /*
         * 4x4 Bayer ordered-dither matrix (0-15) normalised by 16.
         * GLSL ES 1.0 doesn't support dynamic matrix indexing, so we
         * use a dense branch-free(ish) lookup function.
         */
        float bayerValue(int x, int y) {
            int i = x + y * 4;
            if (i == 0)  return 0.0  / 16.0;
            if (i == 1)  return 8.0  / 16.0;
            if (i == 2)  return 2.0  / 16.0;
            if (i == 3)  return 10.0 / 16.0;
            if (i == 4)  return 12.0 / 16.0;
            if (i == 5)  return 4.0  / 16.0;
            if (i == 6)  return 14.0 / 16.0;
            if (i == 7)  return 6.0  / 16.0;
            if (i == 8)  return 3.0  / 16.0;
            if (i == 9)  return 11.0 / 16.0;
            if (i == 10) return 1.0  / 16.0;
            if (i == 11) return 9.0  / 16.0;
            if (i == 12) return 15.0 / 16.0;
            if (i == 13) return 7.0  / 16.0;
            if (i == 14) return 13.0 / 16.0;
            return 5.0 / 16.0;
        }

        /*
         * Map UVs so the sampled video matches CSS object-fit: cover.
         * When u_coverFit == 0.0 this is a no-op (full texture).
         */
        vec2 coverUV(vec2 uv) {
            if (u_coverFit < 0.5) return uv;
            float s;
            if (u_containerAspect > u_videoAspect) {
                // Wider container → scale & crop Y
                s = u_videoAspect / u_containerAspect;
                uv.y = uv.y * s + (1.0 - s) * 0.5;
            } else {
                // Taller container → scale & crop X
                s = u_containerAspect / u_videoAspect;
                uv.x = uv.x * s + (1.0 - s) * 0.5;
            }
            return uv;
        }

        void main() {
            /* 1. Sample video at the correctly-mapped UVs (Y-flipped for video textures) */
            vec2 uv = coverUV(v_uv);
            vec2 videoUV = vec2(uv.x, 1.0 - uv.y);
            vec3 videoColor = texture2D(u_video, videoUV).rgb;

            /* 2. Convert to perceptual luminance */
            float luminance = dot(videoColor, vec3(0.299, 0.587, 0.114));

            /* 3. Screen-space halftone cell (pattern locked to physical pixels) */
            float cell = u_cellSize;
            vec2  px = gl_FragCoord.xy;
            vec2  cellId   = floor(px / cell);
            vec2  cellLocal = fract(px / cell) - 0.5; // −0.5 … +0.5 within cell

            /* 4. Bayer threshold for this cell */
            int bx = int(mod(cellId.x, 4.0));
            int by = int(mod(cellId.y, 4.0));
            float threshold = bayerValue(bx, by);

            /*
             * 5. Highlight extraction — only bright parts of the video
             *    produce dots. The base is the dark site background.
             *
             *    Bright video → large visible pattern
             *    Dark  video → fully transparent / no pattern
             */
            float adjustedL = smoothstep(u_shadowCrush, 1.0, luminance);
            float dithered = adjustedL + (threshold - 0.5) * u_ditherStrength;
            dithered = clamp(dithered, 0.0, 1.0);

            /* 6. Resolve the pattern shape based on u_mode */
            float alpha = 0.0;
            float edgeW = 0.06;          // anti-aliased edge width (in cell-local space)
            float maxRadius = 0.55;      // slight overlap between neighbouring cells when bright

            if (u_mode < 0.5) {
                // ── DOTS ──
                float dist = length(cellLocal);
                float radius = dithered * maxRadius;
                alpha = 1.0 - smoothstep(radius - edgeW, radius + edgeW, dist);

            } else if (u_mode < 1.5) {
                // ── VERTICAL LINES ──
                float dist = abs(cellLocal.x);
                float width = dithered * maxRadius;
                alpha = 1.0 - smoothstep(width - edgeW, width + edgeW, dist);

            } else {
                // ── CROSS-HATCH (diagonal lines) ──
                float d1 = abs(cellLocal.x + cellLocal.y);
                float d2 = abs(cellLocal.x - cellLocal.y);
                float hatchDist = min(d1, d2);
                float hatchWidth = dithered * maxRadius;
                alpha = 1.0 - smoothstep(hatchWidth - edgeW, hatchWidth + edgeW, hatchDist);
            }

            /* Kill remaining phantom pixels when the pattern is effectively zero */
            alpha *= step(0.015, dithered);

            gl_FragColor = vec4(u_fgColor, alpha);
        }
    `

    // ─────────────────────────────────────────────────────────────────────────
    //  UTILITY FUNCTIONS
    // ─────────────────────────────────────────────────────────────────────────
    function compileShader(gl: WebGLRenderingContext, type: number, source: string) {
        const shader = gl.createShader(type)
        if (!shader) return null
        gl.shaderSource(shader, source)
        gl.compileShader(shader)
        if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
            console.error("Shader compile error:", gl.getShaderInfoLog(shader))
            gl.deleteShader(shader)
            return null
        }
        return shader
    }

    function createProgram(gl: WebGLRenderingContext, vsSrc: string, fsSrc: string) {
        const vs = compileShader(gl, gl.VERTEX_SHADER, vsSrc)
        const fs = compileShader(gl, gl.FRAGMENT_SHADER, fsSrc)
        if (!vs || !fs) return null

        const program = gl.createProgram()
        if (!program) return null

        gl.attachShader(program, vs)
        gl.attachShader(program, fs)
        gl.linkProgram(program)

        if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
            console.error("Program link error:", gl.getProgramInfoLog(program))
            gl.deleteProgram(program)
            return null
        }
        return program
    }

    // ─────────────────────────────────────────────────────────────────────────
    //  PER-INSTANCE INITIALISER
    // ─────────────────────────────────────────────────────────────────────────
    function initDitherVideo(wrapper: HTMLElement) {
        const video = wrapper.querySelector("video") as HTMLVideoElement | null
        const canvas = wrapper.querySelector("canvas") as HTMLCanvasElement | null
        if (!video || !canvas) return

        /* ---- Read config from data attributes ---- */
        const cellSize = parseFloat(wrapper.dataset.cellSize || "6")
        const ditherStrength = parseFloat(wrapper.dataset.ditherStrength || "1.0")
        const fgR = parseFloat(wrapper.dataset.fgR || "1.0")
        const fgG = parseFloat(wrapper.dataset.fgG || "1.0")
        const fgB = parseFloat(wrapper.dataset.fgB || "1.0")
        const mode = parseFloat(wrapper.dataset.mode || "0")
        const coverFit = wrapper.dataset.coverFit === "1"
        const shadowCrush = parseFloat(wrapper.dataset.shadowCrush || "0.50")
        const playbackRate = parseFloat(wrapper.dataset.playbackRate || "0.5")

        /* ---- Set playback rate for slower motion ---- */
        try {
            video.playbackRate = playbackRate
        } catch {
            // playbackRate unsupported on this browser
        }

        /* ---- WebGL context with alpha compositing ---- */
        const gl = canvas.getContext("webgl", {
            alpha: true,
            premultipliedAlpha: false,
            antialias: false,
        })
        if (!gl) {
            console.warn("WebGL not available — falling back to plain video.")
            return
        }

        /* ---- Program & geometry ---- */
        const program = createProgram(gl, VERTEX_SHADER, FRAGMENT_SHADER)
        if (!program) return
        gl.useProgram(program)

        // Full-screen quad (2 triangles → triangle strip)
        const positions = new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1])
        const buffer = gl.createBuffer()
        gl.bindBuffer(gl.ARRAY_BUFFER, buffer)
        gl.bufferData(gl.ARRAY_BUFFER, positions, gl.STATIC_DRAW)

        const aPos = gl.getAttribLocation(program, "a_position")
        gl.enableVertexAttribArray(aPos)
        gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0)

        /* ---- Uniform locations ---- */
        const uResolution = gl.getUniformLocation(program, "u_resolution")
        const uCellSize = gl.getUniformLocation(program, "u_cellSize")
        const uDitherStrength = gl.getUniformLocation(program, "u_ditherStrength")
        const uFgColor = gl.getUniformLocation(program, "u_fgColor")
        const uMode = gl.getUniformLocation(program, "u_mode")
        const uVideoAspect = gl.getUniformLocation(program, "u_videoAspect")
        const uContainerAspect = gl.getUniformLocation(program, "u_containerAspect")
        const uCoverFit = gl.getUniformLocation(program, "u_coverFit")
        const uShadowCrush = gl.getUniformLocation(program, "u_shadowCrush")

        /* ---- Static uniforms ---- */
        gl.uniform1f(uCellSize, cellSize)
        gl.uniform1f(uDitherStrength, ditherStrength)
        gl.uniform3f(uFgColor, fgR, fgG, fgB)
        gl.uniform1f(uMode, mode)
        gl.uniform1f(uCoverFit, coverFit ? 1.0 : 0.0)
        gl.uniform1f(uShadowCrush, shadowCrush)

        /* ---- Video texture ---- */
        const texture = gl.createTexture()
        gl.bindTexture(gl.TEXTURE_2D, texture)
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE)
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE)
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR)
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR)

        /* ---- Aspect ratio bookkeeping ---- */
        let videoAspect = 1.0
        const updateVideoAspect = () => {
            const w = video.videoWidth || canvas!.clientWidth
            const h = video.videoHeight || canvas!.clientHeight
            videoAspect = w / Math.max(h, 1)
        }
        video.addEventListener("loadedmetadata", updateVideoAspect, { once: true })
        // Fallback in case metadata is already loaded synchronously
        if (video.videoWidth) updateVideoAspect()

        /* ---- Resize handler (DPR-aware) ---- */
        function resize() {
            const dpr = Math.min(window.devicePixelRatio || 1, 2)
            const width = wrapper.clientWidth
            const height = wrapper.clientHeight

            canvas!.width = width * dpr
            canvas!.height = height * dpr

            gl!.viewport(0, 0, canvas!.width, canvas!.height)
            gl!.uniform2f(uResolution, canvas!.width, canvas!.height)

            const containerAspect = width / Math.max(height, 1)
            gl!.uniform1f(uContainerAspect, containerAspect)
            gl!.uniform1f(uVideoAspect, videoAspect)
        }

        resize()
        window.addEventListener("resize", resize)

        /* ---- Render loop ---- */
        let rafId = 0

        function render() {
            if (video!.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
                try {
                    gl!.bindTexture(gl!.TEXTURE_2D, texture)
                    gl!.texImage2D(
                        gl!.TEXTURE_2D,
                        0,
                        gl!.RGBA,
                        gl!.RGBA,
                        gl!.UNSIGNED_BYTE,
                        video!
                    )
                    gl!.drawArrays(gl!.TRIANGLE_STRIP, 0, 4)
                } catch (e) {
                    // Video frame not yet available for upload — skip silently
                }
            }
            rafId = requestAnimationFrame(render)
        }

        /* ---- Pause rendering when tab is hidden ---- */
        function handleVisibilityChange() {
            if (document.hidden) {
                cancelAnimationFrame(rafId)
                video!.pause()
            } else {
                video!.play().catch(() => {})
                render()
            }
        }
        document.addEventListener("visibilitychange", handleVisibilityChange)

        /* ---- Kick-off when video can play ---- */
        if (video.readyState >= HTMLMediaElement.HAVE_FUTURE_DATA) {
            render()
        } else {
            video.addEventListener("canplay", () => render(), { once: true })
        }

        /* ---- Cleanup on Astro page transitions ---- */
        const cleanup = () => {
            cancelAnimationFrame(rafId)
            window.removeEventListener("resize", resize)
            document.removeEventListener("visibilitychange", handleVisibilityChange)
            gl!.deleteProgram(program)
            gl!.deleteShader(gl!.getAttachedShaders(program)![0])
            gl!.deleteShader(gl!.getAttachedShaders(program)![1])
            gl!.deleteBuffer(buffer)
            gl!.deleteTexture(texture)
        }
        document.addEventListener("astro:before-swap", cleanup, { once: true })
    }

    // ─────────────────────────────────────────────────────────────────────────
    //  AUTO-INITIALISE every instance on the page
    // ─────────────────────────────────────────────────────────────────────────
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches

    if (!prefersReducedMotion) {
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", () => {
                document.querySelectorAll<HTMLElement>(".dither-video-wrapper").forEach(initDitherVideo)
            })
        } else {
            document.querySelectorAll<HTMLElement>(".dither-video-wrapper").forEach(initDitherVideo)
        }
    }
</script>
