# ─────────────────────────────────────────────────
# Client Banner – Environment Variables
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ─────────────────────────────────────────────────

# Site URL (used for sitemaps, canonical links, OG images)
# Must match the deployed Cloudflare Workers URL or custom domain.
SITE_URL=https://devgo.studio

# Client name displayed in the banner heading
# Leave empty for a generic "This site is under development" message.
CLIENT_NAME=

# Contact information shown on the banner
CONTACT_EMAIL=official@devgo.studio
CONTACT_PHONE=

# ── Astro ──────────────────────────────────────
# Set to "production" for production builds
# ASTRO_ENV=production

# ── Cloudflare Workers (deployment) ────────────
# Add Cloudflare-specific vars as needed:
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
